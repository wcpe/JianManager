# IDE
/.idea/
*.swp
*.swo
*~

# Go
/bin/
/dist/
# 裸 go build 默认落根目录的 CP/Worker 二进制（正式产物在 bin/ 与 dist/）
/control-plane
/worker
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work
go.work.sum

# 前端 (apps/* + packages/* pnpm workspace + bot-worker)
node_modules/
dist/
.vite/
*.tsbuildinfo

# 数据库
data/
*.db
*.db-journal
*.db-wal

# 环境变量
.env
.env.dev
.env.local
.env.*.local
# 部署用环境变量（含服务器主机/账号信息，禁止入库）
.env.prod

# 预览 / 过程稿（禁止入库：UI 原型与临时验收脚本）
/index.html
preview.html
docs/**/preview.html
docs/compose/
.tmp/
# 仅忽略仓库根运行时日志目录；internal/worker/logs/** 是 FR-473+ 源码包，必须入库。
/logs/
/data/logs/
/evidence/logs/

# 操作系统
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml
# .tmp 任意层级都忽略（不带前导斜杠）——含 apps/**/.tmp 的验收/e2e 截图，
# 禁止把图片等临时产物提交进库（根锚定 /.tmp/ 曾漏掉子目录的 .tmp）。
.tmp/
/data-demo/
/evidence/
test-results/
/.workbuddy/
/.e2e-upgrade/

# 构建残留与工具缓存（本地跑构建/e2e 的副产物，一律不带前导斜杠 + 通配符，避免再漏任意层级）
# 注意：gitignore 不支持行尾注释，说明必须独占一行，否则整行会被当成字面模式而失效。
# safe-delete 环境的改名回收站（dist 等删不掉时改名留下的产物目录）
.trash-*/
# vite 缓存临时目录（node_modules 之外的残留）
.vite-*/
# vitest 覆盖率产物（lcov / coverage-final.json 等）
coverage/
# playwright 报告与浏览器缓存
playwright-report/
blob-report/
.playwright/
.cache/
*.cache
.eslintcache
.stylelintcache

# 本地工具目录（原先只写在本机 .git/info/exclude，换机器克隆会漏成未跟踪噪声）
/.narrafork/
